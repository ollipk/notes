{
  "name": "notes-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Folk tunes in ABC notation: sheet music and transposition for group sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @notes/web --",
    "build": "npm run build -w @notes/web --",
    "preview": "npm run preview -w @notes/web --",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "depcheck": "depcruise apps/web/src apps/web/tests packages/domain/src",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run depcheck && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
